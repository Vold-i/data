echo "вміст файлу" > *назва файлу*.*формат файлу* //команда ехо створює файл та відразу вносить зміни, файл перебуває в стані untracked
git add . //додає зміни до staging area (підготовлює їх до коміту)
git commit -m "короткий опис того, що зроблено"   //необхідно, щоб відкатати назад, якщо програма ляже
echo "якийсь текст" >> *шлях до файлу* //тут ми вносимо зміни до файлу, дві стрілочки то внести зміни, а одна то повністю перезаписати вміст файлу 
//після цього знову робимо гіт ед і гіт коміт, тому що спершу гіт треба вказати, що потрібно внести в коміт, а потім зробити і самий коміт
//щоб вивести на екран в командлайн вміст файлу використовуємо команду cat  

git log //показує історію комітів, що було зроблеко коли та ким
git diff //показує різницю між поточним станом файлу та останнім комітом

git log --oneline //ця команда показує всю історію файлу
//якщо ми внесли зміни у файл, але ще не додали зміни гіт ед, то ми можемо відмінити змни, до стану попереднього коміту використовуючи команду 
git restore "назва файлу" //відміняє незбережені зміни та повертає файл до стану останнього коміту

rm temp.txt //ця команда для того, що видаляти файли
mv old.txt new.txt //перейменування файлів
